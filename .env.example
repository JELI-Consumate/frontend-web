# Base URL API backend Laravel (mengarah ke prefix /api/v1).
# Web dev lokal memakai localhost (bukan 10.0.2.2 seperti emulator Android).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# OAuth 2.0 Web Client ID dari Google Cloud Console.
# WAJIB tipe "Web application" (client id Android tidak bisa dipakai di web).
# Tambahkan http://localhost:5173 ke "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=
